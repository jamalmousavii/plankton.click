# ============================================
# Plankton Network Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# --- Server ---
NODE_ENV=production
API_PORT=3000
WS_PORT=8444
BACKEND_URL=https://plankton.click

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://plankton:change-me@localhost:5432/plankton

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- NowPayments (7 Cryptocurrencies) ---
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# --- Email (Resend) — password reset links ---
# Required for forgot-password in production; without it the endpoint returns 503
# instead of leaking a reset token in the JSON response.
RESEND_API_KEY=
EMAIL_FROM=Plankton <no-reply@plankton.click>

# --- Sentry (Optional - Error Tracking) ---
SENTRY_DSN=

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================
# Frontend (Next.js) - Copy to frontend/.env.local
# ============================================
# NEXT_PUBLIC_API_URL=https://plankton.click
# NEXT_PUBLIC_WS_URL=wss://plankton.click/ws