{
  "name": "plankton-worker",
  "version": "1.0.0",
  "description": "Plankton Network Worker Application",
  "author": "Plankton Network",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:cli": "node src/cli.js",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "dev": "electron ."
  },
  "dependencies": {
    "axios": "^1.6.2",
    "ethers": "^6.9.0",
    "systeminformation": "^5.21.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "click.plankton.worker",
    "productName": "Plankton Worker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets"
    }
  }
}
