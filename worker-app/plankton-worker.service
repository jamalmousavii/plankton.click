[Unit]
Description=Plankton Network Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKDIR@
ExecStart=@NODE@ src/cli.js
Restart=always
RestartSec=10
TimeoutStopSec=30
Environment=NODE_ENV=production
@ENV_LINES@
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plankton-worker

# Hardening — the worker only needs outbound sockets, read access to its own
# directory and the Ollama port on localhost.
# M10: this file is the single source of truth for the unit; the install
# scripts sed the @USER@/@WORKDIR@/@NODE@/@ENV_LINES@ placeholders into
# /etc/systemd/system/plankton-worker.service, and deploy/plankton-worker.service is
# the pre-filled instance for the server box. Keep the hardening blocks equal.
# ProtectHome=read-only (not `true`): a $HOME/plankton-worker install must stay
# readable for WorkingDirectory, but nothing writes there at runtime.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
